{
  "name": "@araoffice/shell",
  "productName": "ARAOffice",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "Unified ARAOffice shell: one app hosting all editor modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "araoffice.desktop",
  "scripts": {
    "dev": "node scripts/dev.cjs dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/dev.cjs start",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@araoffice/agent-core": "*",
    "@araoffice/ai-provider": "*",
    "@araoffice/electron-utils": "*",
    "@araoffice/i18n": "*",
    "@araoffice/project-store": "*",
    "@araoffice/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "ARAOffice"
}

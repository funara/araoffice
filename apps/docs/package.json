{
  "name": "@araoffice/docs",
  "productName": "ARAOffice Docs",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI-native streaming docx editor with paragraph-patch save",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "parity:report": "node -e \"process.exit((require('node:child_process').spawnSync('npx', ['vitest','run','tests/pagination-parity.test.ts'], {stdio:'inherit',shell:true,env:{...process.env,ARA_WRITE_PARITY_REPORT:'1'}}).status) ?? 1)\"",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "fixtures:corpus": "tsx scripts/generate-corpus.ts"
  },
  "devDependencies": {
    "@araoffice/agent-core": "*",
    "@araoffice/i18n": "*",
    "@araoffice/ai-provider": "*",
    "@araoffice/ai-search": "*",
    "@araoffice/docx-engine": "*",
    "@araoffice/file-parse": "*",
    "@araoffice/project-store": "*",
    "@araoffice/ui": "*",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "author": "ARAOffice",
  "build": {
    "appId": "com.araoffice.docs",
    "productName": "ARAOffice Docs",
    "electronVersion": "43.3.0",
    "artifactName": "AIDocx-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../../.env",
        "to": ".env"
      }
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@araoffice/electron-utils": "*",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "@araoffice/pptx-render": "*"
  }
}
